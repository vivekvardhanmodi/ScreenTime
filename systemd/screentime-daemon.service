[Unit]
Description=ScreenTime Activity Tracker Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PYTHONPATH=/home/vivek/screentime
ExecStart=/home/vivek/screentime/venv/bin/python -m screentime.daemon
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/vivek/screentime

[Install]
WantedBy=graphical-session.target
