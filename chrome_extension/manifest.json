{
  "manifest_version": 3,
  "name": "ScreenTime Tracker",
  "description": "Tracks active tab URL for ScreenTime app usage statistics",
  "version": "1.0.0",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
